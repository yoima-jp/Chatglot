{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "Chatglot",
  "description": "Multilingual Minecraft chat translation mod with AI providers and optional auto-translation.",
  "authors": [
    "yoima"
  ],
  "icon": "assets/chatglot/icon.png",
  "contact": {
    "homepage": "https://modrinth.com/project/chatglot/",
    "sources": "https://github.com/yoima-jp/Chatglot",
    "issues": "https://github.com/yoima-jp/Chatglot/issues/new/choose"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.chatglot.fabric.ChatglotFabricClient"
    ],
    "modmenu": [
      "io.github.chatglot.fabric.config.ChatglotModMenuIntegration"
    ]
  },
  "mixins": [
    "chatglot.mixins.json",
    "chatglot.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "${supported_minecraft_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "cloth-config": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
